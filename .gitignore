.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.py.cover
.cache/

# Local databases and SQLite sidecar files
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.sample
.envrc
.pypirc
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Local configuration and runtime files
*.log
*.pid
*.pid.lock
instance/
local_settings.py

# Editors and IDEs
.idea/
.vscode/*
