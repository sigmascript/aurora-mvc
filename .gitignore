*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/
.python-version

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
sdist/
pip-wheel-metadata/
MANIFEST

